# Etiqueta de las imágenes a usar (latest para main, dev para dev)
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_DB=mydatabase
POSTGRES_USER=user
POSTGRES_PASSWORD=supersecretpassword

# Spring Boot Backend
# El nombre 'postgres_db' es el nombre del servicio en docker-compose
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_db:5432/mydatabase
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# AWS S3 / Minio
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com # O tu endpoint de Minio si lo usas

# Frontend (si necesita variables en tiempo de ejecución)
# Nota: Las variables para Vite se deben prefijar con VITE_ y se insertan en el build.
# Esta es para el Nginx proxy, no para el build de React.
API_BASE_URL=http://your_domain.com/api
