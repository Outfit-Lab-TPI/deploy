# ===== DOCKER CONFIGURATION =====
# Tag de la imagen para deploy (expo para rama deploy/expo)
IMAGE_TAG=expo

# ===== CLOUD CONFIGURATION =====
# ===== Database Connection (PostgreSQL Cloud - Render) =====
# Copiar desde Render Dashboard -> External Database URL
SPRING_DATASOURCE_RENDER_URL=jdbc:postgresql://dpg-xxxxx.oregon-postgres.render.com/tu_database?sslmode=require
SPRING_DATASOURCE_RENDER_USERNAME=tu_usuario_render
SPRING_DATASOURCE_RENDER_PASSWORD=tu_password_render

# ===== Application Security =====
SPRING_SECURITY_USER=admin
SPRING_SECURITY_PASSWORD=admin123

# ===== Application Configuration =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=cloud

# ===== File Upload Limits =====
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# ===== JVM Configuration =====
JAVA_OPTS=-Xmx512m -Xms256m

# ===== Logging Level =====
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_OUTFITLAB=DEBUG

# ===== AWS S3 Configuration =====
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=sa-east-1
AWS_BUCKET_NAME=tu-bucket-name

# ===== FASHION IA =====
FASHION_IA_SECRET_KEY=tu_fashion_ia_api_key

# ===== Frontend API URL =====
API_BASE_URL=https://outfitlab.com.ar/api

# ===== GitHub Container Registry (para docker compose pull) =====
CR_PAT=tu_github_personal_access_token
