# Etiqueta de las imágenes a usar (expo para rama deploy/expo)
IMAGE_TAG=expo

# ============================================
# PostgreSQL en Render
# ============================================
# Copiar la External Database URL de Render (formato: postgres://usuario:contraseña@host:puerto/database)
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxx.oregon-postgres.render.com:5432/tu_database_name
SPRING_DATASOURCE_USERNAME=tu_usuario_render
SPRING_DATASOURCE_PASSWORD=tu_password_render
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ============================================
# AWS S3
# ============================================
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=tu-bucket-name
# Para AWS S3 estándar (NO cambiar si usas AWS real)
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com

# ============================================
# Frontend (Configuración de Nginx)
# ============================================
# Si accedes por IP: http://IP_DE_TU_VM/api
# Si tienes dominio: http://tu_dominio.com/api
API_BASE_URL=http://tu_ip_o_dominio/api
